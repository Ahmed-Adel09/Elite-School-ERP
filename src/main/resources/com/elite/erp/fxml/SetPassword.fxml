<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.elite.erp.presentation.login.SetPasswordController"
           styleClass="root-pane"
           prefWidth="1100" prefHeight="720">

    <Pane styleClass="login-bg"/>

    <VBox fx:id="mainCard" styleClass="login-card" alignment="CENTER" spacing="18"
          maxWidth="420" maxHeight="520">
        <padding><Insets top="48" right="44" bottom="40" left="44"/></padding>

        <Label text="⭐" style="-fx-font-size:42px;"/>
        <Label text="Account Setup" styleClass="login-title"/>
        <Label text="Set your portal password" styleClass="login-subtitle"/>

        <Separator styleClass="gold-separator"/>

        <TextField fx:id="emailField" promptText="Registered Email Address" styleClass="premium-field"/>
        <PasswordField fx:id="passwordField" promptText="New Password" styleClass="premium-field"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" styleClass="premium-field"/>

        <Label fx:id="statusLabel" styleClass="error-label" wrapText="true"/>

        <Button text="Set Password" onAction="#handleSetPassword" styleClass="btn-primary" maxWidth="Infinity"/>

        <Separator styleClass="thin-separator"/>

        <Hyperlink text="Back to Login" onAction="#handleBack" styleClass="gold-link"/>
    </VBox>
</StackPane>
