<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.elite.erp.presentation.login.LoginController"
           styleClass="root-pane"
           prefWidth="1100" prefHeight="720">

    <!-- Background gradient layer -->
    <Pane styleClass="login-bg"/>

    <!-- Centered login card -->
    <VBox fx:id="loginCard" styleClass="login-card" alignment="CENTER" spacing="18"
          maxWidth="420" maxHeight="560">
        <padding><Insets top="48" right="44" bottom="40" left="44"/></padding>

        <!-- School crest placeholder (text-based) -->
        <VBox alignment="CENTER" spacing="8">
            <ImageView fitWidth="160" preserveRatio="true">
                <image>
                    <Image url="@../images/vertex_logo.png"/>
                </image>
            </ImageView>
            <Label text="VERTEX ACADEMY" styleClass="school-name-label" style="-fx-font-size: 22px;"/>
            <Label text="Excellence · Integrity · Innovation" styleClass="school-motto"/>
        </VBox>

        <Separator styleClass="gold-separator"/>

        <Label text="Welcome Back" styleClass="login-title"/>
        <Label text="Sign in to the ERP Portal" styleClass="login-subtitle"/>

        <TextField fx:id="emailField" promptText="Email Address" styleClass="premium-field"/>
        <PasswordField fx:id="passwordField" promptText="Password" styleClass="premium-field"/>

        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

        <Button text="Sign In" onAction="#handleLogin" styleClass="btn-primary" maxWidth="Infinity"/>

        <HBox alignment="CENTER">
            <Hyperlink text="First time login? Set Password" onAction="#handleSetPassword" styleClass="gold-link" style="-fx-font-size:13px;"/>
        </HBox>

        <Separator styleClass="thin-separator"/>

        <!-- Apply | Join Us — centred -->
        <HBox alignment="CENTER" spacing="8">
            <Hyperlink fx:id="applyLink" text="Apply" onAction="#handleApply" styleClass="gold-link"/>
            <Label text="|" styleClass="link-hint"/>
            <Hyperlink fx:id="joinLink" text="Join Us" onAction="#handleJoinUs" styleClass="gold-link"/>
        </HBox>

        <!-- Admin Portal — centred -->
        <HBox alignment="CENTER">
            <Hyperlink text="🛡 Admin Portal" onAction="#handleAdminPortal" styleClass="gold-link"
                       style="-fx-font-size:12px;"/>
        </HBox>
    </VBox>
</StackPane>
