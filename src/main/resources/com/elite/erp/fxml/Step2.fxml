<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.elite.erp.presentation.admission.Step2Controller"
            styleClass="root-pane" prefWidth="1100" prefHeight="720">

    <top>
        <VBox styleClass="wizard-header">
            <Label text="Vertex Academy — Admission Portal" styleClass="wizard-school-name"/>
            <HBox alignment="CENTER" spacing="0" styleClass="progress-bar-row">
                <Label text="1 Landing" styleClass="prog-step prog-done"/>
                <Label text="——" styleClass="prog-arrow"/>
                <Label text="2 Parents" styleClass="prog-step prog-active"/>
                <Label text="——" styleClass="prog-arrow"/>
                <Label text="3 Student" styleClass="prog-step"/>
                <Label text="——" styleClass="prog-arrow"/>
                <Label text="4 Medical" styleClass="prog-step"/>
                <Label text="——" styleClass="prog-arrow"/>
                <Label text="5 Checkout" styleClass="prog-step"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-transparent">
            <VBox spacing="16" styleClass="form-card">
                <padding><Insets top="32" right="80" bottom="32" left="80"/></padding>

                <Label text="Parent / Guardian Details" styleClass="form-section-title"/>
                <Label text="Please provide contact information for the student's guardians."
                       styleClass="form-section-subtitle"/>

                <GridPane hgap="20" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <Label text="Father's Full Name" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="fatherNameField" promptText="Father's name" styleClass="premium-field"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                    <Label text="Mother's Full Name" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <TextField fx:id="motherNameField" promptText="Mother's name" styleClass="premium-field"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Email Address *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="emailField" promptText="parent@email.com" styleClass="premium-field"
                               GridPane.columnIndex="0" GridPane.rowIndex="3"/>

                    <Label text="Phone Number" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <TextField fx:id="phoneField" promptText="+1 234 567 8900" styleClass="premium-field"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Home Address" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="addressField" promptText="Street, City, Country" styleClass="premium-field"
                               GridPane.columnIndex="0" GridPane.rowIndex="5"/>

                    <Label text="Occupation" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    <TextField fx:id="occupationField" promptText="e.g. Engineer, Doctor" styleClass="premium-field"
                               GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                </GridPane>

                <!-- Corporate Sponsorship Toggle -->
                <ToggleButton fx:id="corporateToggle" text="🏢 Corporate Sponsorship"
                              onAction="#toggleCorporate" styleClass="toggle-sponsor"/>

                <!-- Hidden section revealed by animation -->
                <VBox fx:id="corporateSection" spacing="12" styleClass="sponsor-box">
                    <Label text="Corporate Sponsor Details" styleClass="field-label" style="-fx-font-weight:bold;"/>
                    <GridPane hgap="20" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <TextField fx:id="companyNameField" promptText="Company Name" styleClass="premium-field"
                                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="companyEmailField" promptText="Company Email" styleClass="premium-field"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <TextField fx:id="sponsorAmountField" promptText="Sponsorship Amount (USD)" styleClass="premium-field"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    </GridPane>
                </VBox>

                <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="wizard-footer" alignment="CENTER_RIGHT" spacing="12">
            <padding><Insets top="16" right="40" bottom="16" left="40"/></padding>
            <Button text="← Back" onAction="#goBack" styleClass="btn-secondary"/>
            <Button text="Continue →" onAction="#goNext" styleClass="btn-primary"/>
        </HBox>
    </bottom>
</BorderPane>
