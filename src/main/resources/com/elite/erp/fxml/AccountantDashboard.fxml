<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.elite.erp.presentation.accountant.AccountantDashboardController"
            styleClass="root-pane" prefWidth="1280" prefHeight="820"
            stylesheets="@../css/Premium.css">

    <!-- TOP HEADER BAR -->
    <top>
        <HBox styleClass="header-bar" spacing="20" alignment="CENTER_LEFT">
            <padding><Insets top="12" right="28" bottom="12" left="28"/></padding>
            <ImageView fitHeight="42" preserveRatio="true">
                <image><Image url="@../images/vertex_logo.png"/></image>
            </ImageView>
            <VBox spacing="0">
                <Label text="VERTEX ACADEMY" style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#C9A84C;"/>
                <Label text="Accountant Financial Portal" style="-fx-font-size:12px; -fx-text-fill:rgba(255,255,255,0.7);"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="summaryLabel" text="Loading financials..."
                   style="-fx-text-fill:#4CD97B; -fx-font-weight:bold; -fx-font-size:13px;"/>
            <Separator orientation="VERTICAL" style="-fx-background-color:rgba(255,255,255,0.2);"/>
            <Button text="🚪 Logout" onAction="#logout" styleClass="btn-secondary"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <!-- ══ TAB 1: FXGL ANALYTICS ══ -->
            <Tab text="📊 Revenue Analytics">
                <VBox spacing="20">
                    <padding><Insets top="24" right="30" bottom="24" left="30"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label text="Live Financial Overview"
                               style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#0A1628;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="🔄 Refresh" onAction="#refreshChart"
                                style="-fx-background-color:#1A3560; -fx-text-fill:white; -fx-cursor:hand;"/>
                    </HBox>

                    <!-- Revenue stat cards -->
                    <HBox spacing="20">
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:#f0fdf4; -fx-padding:20; -fx-background-radius:10; -fx-border-color:#4CD97B; -fx-border-radius:10;">
                            <Label text="✅ Collected Revenue" style="-fx-font-size:14px; -fx-text-fill:#166534;"/>
                            <Label fx:id="paidLabel" text="USD 0.00"
                                   style="-fx-font-size:32px; -fx-font-weight:bold; -fx-text-fill:#4CD97B;"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:#fff7ed; -fx-padding:20; -fx-background-radius:10; -fx-border-color:#F5A623; -fx-border-radius:10;">
                            <Label text="⚠️ Outstanding Dues" style="-fx-font-size:14px; -fx-text-fill:#92400E;"/>
                            <Label fx:id="pendingLabel" text="USD 0.00"
                                   style="-fx-font-size:32px; -fx-font-weight:bold; -fx-text-fill:#FF6B6B;"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:#eff6ff; -fx-padding:20; -fx-background-radius:10; -fx-border-color:#1A3560; -fx-border-radius:10;">
                            <Label text="📋 Total Invoices" style="-fx-font-size:14px; -fx-text-fill:#1e40af;"/>
                            <Label fx:id="totalInvoicesLabel" text="0"
                                   style="-fx-font-size:32px; -fx-font-weight:bold; -fx-text-fill:#1A3560;"/>
                        </VBox>
                    </HBox>

                    <!-- FXGL BarChart embedded here -->
                    <StackPane fx:id="chartPane" prefHeight="380"
                               style="-fx-background-color:#0A1628; -fx-background-radius:10;">
                        <Label text="Initialising Vertex AI Chart Engine..."
                               style="-fx-text-fill:#C9A84C; -fx-font-size:14px;"/>
                    </StackPane>
                </VBox>
            </Tab>

            <!-- ══ TAB 2: INVOICING ══ -->
            <Tab text="🧾 Invoicing">
                <VBox spacing="20">
                    <padding><Insets top="24" right="30" bottom="24" left="30"/></padding>
                    <Label text="Generate &amp; Manage Tuition Invoices"
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#0A1628;"/>

                    <!-- Invoice generation form -->
                    <HBox spacing="20" style="-fx-background-color:#f8fafc; -fx-padding:20; -fx-background-radius:10; -fx-border-color:#e2e8f0; -fx-border-radius:10;">
                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <Label text="Select Student:" style="-fx-font-weight:bold;"/>
                            <ComboBox fx:id="studentCombo" promptText="Search and select student..."
                                      prefWidth="300" onAction="#onStudentSelected"/>

                            <Label text="Amount (USD):" style="-fx-font-weight:bold;"/>
                            <TextField fx:id="amountField" promptText="e.g. 5000.00" prefWidth="200"
                                       styleClass="premium-field"/>

                            <Label text="Description:" style="-fx-font-weight:bold;"/>
                            <TextField fx:id="descriptionField" promptText="e.g. Term 1 Tuition Fee"
                                       prefWidth="400" styleClass="premium-field"/>

                            <HBox spacing="12">
                                <Button text="📄 Generate Invoice" onAction="#generateInvoice"
                                        style="-fx-background-color:#1A3560; -fx-text-fill:white; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:10 24;"/>
                                <Label fx:id="invoiceStatusLabel" text=""
                                       style="-fx-font-weight:bold; -fx-font-size:13px;"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- All invoices table -->
                    <Label text="All Invoices:" style="-fx-font-weight:bold; -fx-font-size:16px;"/>
                    <TableView fx:id="invoicesTable" VBox.vgrow="ALWAYS" styleClass="premium-table">
                        <columns>
                            <TableColumn fx:id="invColId"      text="ID"          prefWidth="60"/>
                            <TableColumn fx:id="invColStudent" text="Student"      prefWidth="200"/>
                            <TableColumn fx:id="invColAmount"  text="Amount"       prefWidth="120"/>
                            <TableColumn fx:id="invColStatus"  text="Status"       prefWidth="120"/>
                            <TableColumn fx:id="invColDate"    text="Issue Date"   prefWidth="140"/>
                            <TableColumn fx:id="invColDesc"    text="Description"  prefWidth="260"/>
                        </columns>
                    </TableView>

                    <HBox spacing="12">
                        <Button text="✅ Mark Selected as PAID" onAction="#markPaid"
                                style="-fx-background-color:#4CD97B; -fx-text-fill:#0A1628; -fx-font-weight:bold; -fx-cursor:hand;"/>
                        <Button text="🗑️ Delete Invoice" onAction="#deleteInvoice"
                                style="-fx-background-color:#FF6B6B; -fx-text-fill:white; -fx-cursor:hand;"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- ══ TAB 3: PAYROLL ══ -->
            <Tab text="💼 Payroll">
                <VBox spacing="20">
                    <padding><Insets top="24" right="30" bottom="24" left="30"/></padding>
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label text="Staff Payroll Management"
                               style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#0A1628;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="payrollStatusLabel" text=""
                               style="-fx-font-weight:bold; -fx-font-size:13px;"/>
                    </HBox>

                    <TableView fx:id="payrollTable" VBox.vgrow="ALWAYS" styleClass="premium-table">
                        <columns>
                            <TableColumn fx:id="prColName"   text="Staff Member"  prefWidth="220"/>
                            <TableColumn fx:id="prColRole"   text="Role"          prefWidth="140"/>
                            <TableColumn fx:id="prColEmail"  text="Email"         prefWidth="240"/>
                            <TableColumn fx:id="prColSalary" text="Monthly Salary (USD)" prefWidth="180"/>
                            <TableColumn fx:id="prColStatus" text="Pay Status"    prefWidth="140"/>
                        </columns>
                    </TableView>

                    <HBox spacing="12">
                        <Button text="💳 Process Payment for Selected" onAction="#processPayment"
                                style="-fx-background-color:#C9A84C; -fx-text-fill:#0A1628; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:10 24;"/>
                        <Button text="💳 Process ALL Payroll" onAction="#processAllPayroll"
                                style="-fx-background-color:#1A3560; -fx-text-fill:white; -fx-font-weight:bold; -fx-cursor:hand; -fx-padding:10 24;"/>
                    </HBox>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
