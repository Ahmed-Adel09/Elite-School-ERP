<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.elite.erp.presentation.admission.Step4Controller"
            styleClass="root-pane" prefWidth="1100" prefHeight="720">

    <top>
        <VBox styleClass="wizard-header">
            <Label text="Vertex Academy — Admission Portal" styleClass="wizard-school-name"/>
            <HBox alignment="CENTER" spacing="0" styleClass="progress-bar-row">
                <Label text="1 Landing"  styleClass="prog-step prog-done"/>
                <Label text="——" styleClass="prog-arrow"/>
                <Label text="2 Parents"  styleClass="prog-step prog-done"/>
                <Label text="——" styleClass="prog-arrow"/>
                <Label text="3 Student"  styleClass="prog-step prog-done"/>
                <Label text="——" styleClass="prog-arrow"/>
                <Label text="4 Medical"  styleClass="prog-step prog-active"/>
                <Label text="——" styleClass="prog-arrow"/>
                <Label text="5 Checkout" styleClass="prog-step"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" styleClass="form-card">
            <padding><Insets top="36" right="80" bottom="36" left="80"/></padding>

            <Label text="Medical &amp; Wellbeing Information" styleClass="form-section-title"/>
            <Label text="This information is kept strictly confidential and shared only with the school nurse."
                   styleClass="form-section-subtitle"/>

            <VBox spacing="8">
                <Label text="Known Allergies" styleClass="field-label"/>
                <TextArea fx:id="allergyArea" promptText="List any known allergies (food, medication, environmental)..."
                          styleClass="premium-textarea" prefRowCount="4" wrapText="true"/>
            </VBox>

            <VBox spacing="8">
                <Label text="Medical Notes / Conditions" styleClass="field-label"/>
                <TextArea fx:id="medicalNotesArea"
                          promptText="Any medical conditions, special needs, or medication the school should be aware of..."
                          styleClass="premium-textarea" prefRowCount="4" wrapText="true"/>
            </VBox>

            <VBox spacing="10">
                <Label text="Vaccination Record" styleClass="field-label"/>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Button fx:id="browseVaccinationBtn" text="📎 Upload Vaccination Record"
                            onAction="#browseVaccinationRecord" styleClass="btn-secondary"/>
                    <Label fx:id="vaccinationLabel" text="No file selected"
                           styleClass="file-label"/>
                </HBox>
                <Label text="Accepted: PDF, JPG, PNG, DOCX" styleClass="hint-label"/>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="wizard-footer" alignment="CENTER_RIGHT" spacing="12">
            <padding><Insets top="16" right="40" bottom="16" left="40"/></padding>
            <Button text="← Back" onAction="#goBack" styleClass="btn-secondary"/>
            <Button text="Continue →" onAction="#goNext" styleClass="btn-primary"/>
        </HBox>
    </bottom>
</BorderPane>
