<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.elite.erp.presentation.clinic.StudentClinicController"
      spacing="24" style="-fx-background-color: #0A1628;">

    <padding><Insets top="28" right="36" bottom="28" left="36"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <Label text="🏥 My Medical Profile" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statusLabel" text="" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Profile Card -->
    <VBox spacing="16" style="-fx-background-color: #1A3560; -fx-padding: 24; -fx-background-radius: 12; -fx-border-color: #C9A84C; -fx-border-radius: 12;">
        <Label text="Personal Health Information" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #C9A84C;"/>

        <GridPane hgap="20" vgap="14">
            <Label text="Blood Type:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="bloodTypeLabel" text="—" style="-fx-text-fill: white; -fx-font-size: 14px;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Known Allergies:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="allergiesLabel" text="—" style="-fx-text-fill: #FF9999; -fx-font-size: 14px;" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Emergency Contact:" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="emergencyLabel" text="—" style="-fx-text-fill: white; -fx-font-size: 14px;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>

    <!-- Recent Visits -->
    <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: #1A3560; -fx-padding: 20; -fx-background-radius: 10;">
        <Label text="My Clinic Visit History" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #C9A84C;"/>
        <TableView fx:id="visitsTable" VBox.vgrow="ALWAYS" styleClass="premium-table">
            <columns>
                <TableColumn fx:id="colDate" text="Date &amp; Time" prefWidth="180"/>
                <TableColumn fx:id="colSymptoms" text="Symptoms" prefWidth="250"/>
                <TableColumn fx:id="colTreatment" text="Treatment Given" prefWidth="250"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Emergency Button -->
    <HBox alignment="CENTER">
        <Button fx:id="emergencyBtn" text="🚨  Request Nurse Assistance NOW"
                onAction="#requestNurse"
                style="-fx-background-color: #FF3B3B; -fx-text-fill: white; -fx-font-size: 16px;
                       -fx-font-weight: bold; -fx-padding: 14 40; -fx-background-radius: 8;
                       -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(255,59,59,0.5), 15, 0, 0, 0);"/>
    </HBox>

</VBox>
