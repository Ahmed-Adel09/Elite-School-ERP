<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.elite.erp.presentation.admission.Step1Controller"
            styleClass="root-pane" prefWidth="1100" prefHeight="720">

    <!-- TOP: Progress bar -->
    <top>
        <VBox styleClass="wizard-header">
            <Label text="Vertex Academy — Admission Portal" styleClass="wizard-school-name"/>
            <HBox alignment="CENTER" spacing="0" styleClass="progress-bar-row">
                <Label text="1 Landing" styleClass="prog-step prog-active"/>
                <Label text="——" styleClass="prog-arrow"/>
                <Label text="2 Parents" styleClass="prog-step"/>
                <Label text="——" styleClass="prog-arrow"/>
                <Label text="3 Student" styleClass="prog-step"/>
                <Label text="——" styleClass="prog-arrow"/>
                <Label text="4 Medical" styleClass="prog-step"/>
                <Label text="——" styleClass="prog-arrow"/>
                <Label text="5 Checkout" styleClass="prog-step"/>
            </HBox>
        </VBox>
    </top>

    <!-- CENTER: Hero + Timeline -->
    <center>
        <VBox fx:id="heroPane" alignment="CENTER" spacing="32" styleClass="step1-hero">
            <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

            <HBox alignment="CENTER_RIGHT">
                <ToggleButton fx:id="langToggle" text="🌐 EN | AR"
                              onAction="#toggleLanguage" styleClass="lang-toggle"/>
            </HBox>

            <Label fx:id="welcomeTitle" styleClass="hero-title" wrapText="true"
                   text="Apply to Vertex Academy"/>
            <Label fx:id="welcomeSubtitle" styleClass="hero-subtitle"
                   text="Begin your journey to academic excellence"/>

            <!-- Visual timeline -->
            <HBox alignment="CENTER" spacing="8" styleClass="timeline-row">
                <VBox alignment="CENTER" styleClass="timeline-step">
                    <Label text="①" styleClass="timeline-number"/>
                    <Label fx:id="step1Label" text="📋 Form" styleClass="timeline-label"/>
                </VBox>
                <Label text="━━━━" styleClass="timeline-connector"/>
                <VBox alignment="CENTER" styleClass="timeline-step">
                    <Label text="②" styleClass="timeline-number"/>
                    <Label fx:id="step2Label" text="💳 Pay" styleClass="timeline-label"/>
                </VBox>
                <Label text="━━━━" styleClass="timeline-connector"/>
                <VBox alignment="CENTER" styleClass="timeline-step">
                    <Label text="③" styleClass="timeline-number"/>
                    <Label fx:id="step3Label" text="📝 Exam" styleClass="timeline-label"/>
                </VBox>
                <Label text="━━━━" styleClass="timeline-connector"/>
                <VBox alignment="CENTER" styleClass="timeline-step">
                    <Label text="④" styleClass="timeline-number"/>
                    <Label fx:id="step4Label" text="✅ Decision" styleClass="timeline-label"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <!-- BOTTOM: Navigation -->
    <bottom>
        <HBox styleClass="wizard-footer" alignment="CENTER_RIGHT" spacing="12">
            <padding><Insets top="16" right="40" bottom="16" left="40"/></padding>
            <Button text="← Back to Login" onAction="#goBack" styleClass="btn-secondary"/>
            <Button text="Continue →" onAction="#goNext" styleClass="btn-primary"/>
        </HBox>
    </bottom>
</BorderPane>
